# LabTrack Environment Configuration
# Copy this file to .env and update values for your environment

# Application
NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=labtrack
DB_USER=labtrack
DB_PASSWORD=labtrack_dev_password

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
